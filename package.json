{
  "name": "dsh-super-session",
  "version": "0.1.0",
  "description": "A globally unique Super Session for DeepSeek Harness: clarifies and relays requirements, manages tasks, monitors workers, and keeps user memory.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "session",
    "manager"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "test": "node test/smoke.mjs && node test/wechat.mjs && node test/wechat-pause.mjs && node test/wechat-file.mjs && node test/approvals.mjs && node test/grants.mjs && node test/startup.mjs && node test/worker-idle.mjs && node test/dispatch-guard.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/approvals.mjs",
    "lib/grants.mjs",
    "lib/worker-idle.mjs",
    "lib/dispatch-guard.mjs",
    "lib/wechat",
    "cordis.patch.yml",
    "DESIGN.md",
    "README.md",
    "docs"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  }
}
