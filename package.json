{
  "name": "dsh-ria",
  "version": "0.1.0",
  "description": "Ria for DeepSeek Harness: one resident manager that relays requests, tracks tickets, watches executors, and keeps your memory.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "ria",
    "session",
    "manager"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "router": "node lib/router/cli.mjs",
    "router:test": "node test/router.mjs",
    "test": "node scripts/run-tests.mjs && node test/ria-chat-send-file.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/router",
    "lib/core",
    "lib/roles",
    "lib/prompts",
    "lib/store",
    "lib/tools",
    "lib/shared",
    "lib/tickets.mjs",
    "lib/topics.mjs",
    "lib/router-events.mjs",
    "lib/grants.mjs",
    "lib/turn-end.mjs",
    "lib/outbox.mjs",
    "lib/reflection.mjs",
    "lib/reflection-sage-context.mjs",
    "lib/role-context.mjs",
    "lib/memory.mjs",
    "lib/text-size.mjs",
    "lib/state",
    "lib/wechat",
    "lib/channels",
    "scripts",
    "cordis.patch.yml",
    "DESIGN.md",
    "README.md",
    "docs"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  },
  "dependencies": {
    "@tencent-connect/qqbot-nodejs": "^1.0.5",
    "qrcode": "^1.5.4"
  }
}
